# PheedLoop API credentials — copy this file to `.env` and fill in the values.
# Find these in the Dashboard: Settings -> Integrations -> REST API.
# (These are the same org/event as Orientation Group Assigner.py.)

PHEEDLOOP_ORG_CODE=ORG2J3207CTQTEFVBT
PHEEDLOOP_EVENT_CODE=EVEMFFRKMCZTH
PHEEDLOOP_API_KEY=your_api_key_here
PHEEDLOOP_API_SECRET=your_api_secret_here

# Optional overrides (defaults are set in the script):
# SPREADSHEET_PATH=notifications.xlsx
# WEEK_START_SUNDAY=2026-08-30
